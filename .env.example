# Core BacDive inputs
BD_PRED_CSV=/path/to/data/bd_pred_new_full.csv
BD_LABELS_CSV=/path/to/data/training_morphcomplete_norm_na_rm.csv
BD_SPLITS_CSV=/path/to/data/training_morphcomplete_labels_2024-01-31.csv
GENOME_FAMILY_MAP_CSV=/absolute/path/to/repo/genome_family_map.csv

# Selection-model artifacts (local copy)
SELECTION_PROBS_RDS=/absolute/path/to/repo/data/selection/selection_probs.rds
BUGPHYZZ_PROXIES_RDS=/absolute/path/to/repo/data/selection/bugphyzz_with_proxies.rds

# Evaluation / inference inputs
COUNT_LIST_RDS=/path/to/data/count_list.rds
BACDIVE_COMPLETE_RDS=/path/to/data/bacdive_complete.rds
FASTA_DIR=/path/to/fasta_dir
CHECKPOINTS_DIR=/path/to/checkpoints
MICROBE_CARDS_XLSX=/path/to/microbe_cards_s1.xlsx

# Output locations
REPORTS_DIR=/absolute/path/to/repo
OUTPUT_DIR=/absolute/path/to/repo/output
FIGURES_DIR=/absolute/path/to/repo/figures
SLURM_OUTPUT_DIR=/absolute/path/to/repo/slurm_output
BACDIVE_TEST_RDS=/absolute/path/to/repo/output/bacdive_test.rds

# SLURM helper script settings
BACDIVE_CONDA_SH=/path/to/miniconda3/etc/profile.d/conda.sh
BACDIVE_TF_ENV=tf
EVAL_SCRIPT_PATH=/absolute/path/to/repo/R/eval_test.R

# Multiclass calibration options
ENABLE_DIRICHLET_MULTICLASS=false
